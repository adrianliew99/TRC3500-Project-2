/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_TIM2_Init();
  MX_ADC1_Init();
  /* USER CODE BEGIN 2 */
  // Start Peripherals
  HAL_ADCEx_Calibration_Start(&hadc1, ADC_SINGLE_ENDED);

  // FIX: Start DMA FIRST, then Start Timer!
  HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, BUFFER_SIZE);
  HAL_TIM_Base_Start(&htim2);

  // Start listening to Python via UART
  HAL_UART_Receive_IT(&huart2, &rx_byte, 1);

  // Calibrate the exact DC offset immediately
  Auto_Zero_Routine();
  // OLD: sprintf(tx_buf, "STM32_READY|MID_RAIL:%lu\n", dynamic_mid_rail);
  sprintf(tx_buf, "STM32_READY|MID_RAIL:%lu\n", (uint32_t)dynamic_mid_rail);
  HAL_UART_Transmit(&huart2, (uint8_t*)tx_buf, strlen(tx_buf), HAL_MAX_DELAY);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      // --- 1. HANDLE PYTHON COMMANDS ---
      if (msg_received) {
          msg_received = 0;

          if (strcmp(rx_buffer, "CMD:CALIBRATE") == 0) {
              current_sys_state = SYS_CALIBRATING;
              learn_stage = 0; drops_this_stage = 0; temp_energy_accumulator = 0;
              sprintf(tx_buf, "ACK:CALIBRATING\n");
              HAL_UART_Transmit(&huart2, (uint8_t*)tx_buf, strlen(tx_buf), HAL_MAX_DELAY);
          }
          else if (strncmp(rx_buffer, "CMD:LOAD", 8) == 0) {
              // Python sends: CMD:LOAD,1000,2000,3000,4000
              sscanf(rx_buffer, "CMD:LOAD,%lu,%lu,%lu,%lu",
                     &learned_profiles[0], &learned_profiles[1],
                     &learned_profiles[2], &learned_profiles[3]);
              current_sys_state = SYS_TEST;
              sprintf(tx_buf, "ACK:LOADED_AND_TESTING\n");
              HAL_UART_Transmit(&huart2, (uint8_t*)tx_buf, strlen(tx_buf), HAL_MAX_DELAY);
          }
          else if (strcmp(rx_buffer, "CMD:INITIAL") == 0) {
              current_sys_state = SYS_INITIAL;
              sprintf(tx_buf, "ACK:INITIAL\n");
              HAL_UART_Transmit(&huart2, (uint8_t*)tx_buf, strlen(tx_buf), HAL_MAX_DELAY);
          }
      }

      // --- 2. THE DSP ENGINE (Only runs if data is ready) ---
		if (data_ready_flag) {
			data_ready_flag = 0;
			int start_idx = process_first_half ? 0 : (BUFFER_SIZE / 2);
			int end_idx = process_first_half ? (BUFFER_SIZE / 2) : BUFFER_SIZE;

			for (int i = start_idx; i < end_idx; i++) {
				uint16_t sample = adc_buffer[i];

				uint32_t magnitude = abs((int32_t)sample - (int32_t)dynamic_mid_rail);
				int8_t current_polarity = (sample > dynamic_mid_rail) ? 1 : -1;

				switch (current_dsp_state) {

					case DSP_IDLE:
						// Smoothly track the baseline ONLY when the room is quiet
						dynamic_mid_rail = (0.999f * dynamic_mid_rail) + (0.001f * (float)sample);

						sta = sta + ((magnitude - sta) >> STA_SHIFT);
						lta = lta + ((magnitude - lta) >> LTA_SHIFT);

						// RAISED FLOOR: Changed 'sta > 50' to 'sta > 150' so normal room chatter doesn't falsely trigger it
						if (lta > 0 && sta > (lta * TRIGGER_RATIO) && sta > 150) {
							current_dsp_state = DSP_VALIDATING;
							state_timer = 0; ring_count = 0; energy_sum = 0;
							prev_polarity = current_polarity;
						}
						break;

					case DSP_VALIDATING:
						state_timer++;

						// NOISE GATE: Only add the energy that sits *above* the frozen ambient noise floor (lta)
						if (magnitude > (lta + 5)) {
							energy_sum += (magnitude - lta);
						}

						if (current_polarity != prev_polarity) {
							ring_count++;
							prev_polarity = current_polarity;
						}

						if (state_timer >= VALIDATION_WINDOW_LEN) {

							// NOTE: I lowered this from 10000 to 2000 because our new noise gate
							// drastically reduces the total energy calculated (which is a good thing!)
							if (energy_sum < 2000) {
								current_dsp_state = DSP_COOLDOWN;
								state_timer = 0;
								break;
							}

							if (ring_count >= 3 && current_sys_state != SYS_INITIAL) {
								// ... The rest of your code remains exactly the same from here down! ...
								// --- STATE: CALIBRATING ---
								if (current_sys_state == SYS_CALIBRATING) {
									temp_energy_accumulator += energy_sum;
									drops_this_stage++;

									sprintf(tx_buf, "CAL_DROP:%d|ENERGY:%lu\n", drops_this_stage, energy_sum);
									HAL_UART_Transmit(&huart2, (uint8_t*)tx_buf, strlen(tx_buf), HAL_MAX_DELAY);

									if (drops_this_stage >= 3) {
										learned_profiles[learn_stage] = temp_energy_accumulator / 3;
										sprintf(tx_buf, "CAL_STAGE_DONE:%d|CENTROID:%lu\n", learn_stage, learned_profiles[learn_stage]);
										HAL_UART_Transmit(&huart2, (uint8_t*)tx_buf, strlen(tx_buf), HAL_MAX_DELAY);

										learn_stage++;
										drops_this_stage = 0; temp_energy_accumulator = 0;

										if (learn_stage >= 4) {
											current_sys_state = SYS_INITIAL;
											sprintf(tx_buf, "CAL_COMPLETE:%lu,%lu,%lu,%lu\n",
												learned_profiles[0], learned_profiles[1],
												learned_profiles[2], learned_profiles[3]);
											HAL_UART_Transmit(&huart2, (uint8_t*)tx_buf, strlen(tx_buf), HAL_MAX_DELAY);
										}
									}
								}
								// --- STATE: TEST MODE ---
								else if (current_sys_state == SYS_TEST) {
									uint8_t best_idx = 0;
									uint32_t min_err = 0xFFFFFFFF;

									for (uint8_t j = 0; j < 4; j++) {
										uint32_t err = (energy_sum > learned_profiles[j]) ?
													   (energy_sum - learned_profiles[j]) :
													   (learned_profiles[j] - energy_sum);
										if (err < min_err) { min_err = err; best_idx = j; }
									}

									sprintf(tx_buf, "TEST_RESULT|ENERGY:%lu|CLASS:%d\n", energy_sum, best_idx);
									HAL_UART_Transmit(&huart2, (uint8_t*)tx_buf, strlen(tx_buf), HAL_MAX_DELAY);
								}
							}
							current_dsp_state = DSP_COOLDOWN;
							state_timer = 0;
						}
						break;

					case DSP_COOLDOWN:
						state_timer++;
						if (state_timer >= COOLDOWN_LEN) {
							// FIX: Removed the baseline snap here.
							// It will now unfreeze and smoothly continue from the perfect pre-drop baseline!
							sta = 0;
							lta = 0;
							magnitude = 0; // Clear the local variable
							current_dsp_state = DSP_IDLE;
							// --- NEW: TELL PYTHON WE ARE READY ---
							  sprintf(tx_buf, "READY_FOR_NEXT\n");
							  HAL_UART_Transmit(&huart2, (uint8_t*)tx_buf, strlen(tx_buf), HAL_MAX_DELAY);
						}
						break;
				}
			}
		}
    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

