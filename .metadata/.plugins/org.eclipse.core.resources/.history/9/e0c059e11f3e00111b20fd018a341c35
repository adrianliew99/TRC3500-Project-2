// UART Receive Interrupt (Listens to Python)
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
    if (huart->Instance == USART2) {
        if (rx_byte == '\n' || rx_byte == '\r') {
            rx_buffer[rx_index] = '\0'; // Null terminate
            msg_received = 1;
            rx_index = 0;
        } else {
            rx_buffer[rx_index++] = rx_byte;
            if (rx_index >= 50) rx_index = 0; // Prevent overflow
        }
        // Re-arm the interrupt
        HAL_UART_Receive_IT(&huart2, &rx_byte, 1);
    }
}

// Helper to calculate Mid-Rail automatically
void Auto_Zero_Routine(void) {
    uint32_t cal_sum = 0, cal_samples = 0;
    while (cal_samples < 10000) {
        if (data_ready_flag) {
            data_ready_flag = 0;
            int start_idx = process_first_half ? 0 : (BUFFER_SIZE / 2);
            int end_idx = process_first_half ? (BUFFER_SIZE / 2) : BUFFER_SIZE;
            for (int i = start_idx; i < end_idx; i++) {
                cal_sum += adc_buffer[i];
                cal_samples++;
                if (cal_samples >= 10000) break;
            }
        }
    }
    // Cast to float for precision
    dynamic_mid_rail = (float)cal_sum / 10000.0f;
}
