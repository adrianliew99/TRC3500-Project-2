/* USER CODE BEGIN PV */
#define BUFFER_SIZE 512
#define STA_SHIFT 3
#define LTA_SHIFT 9
#define TRIGGER_RATIO 3
// TIGHTENED WINDOW: Reduced from 1000 to 500 to soak up less background noise
#define VALIDATION_WINDOW_LEN 500
#define COOLDOWN_LEN 50000

// --- SYSTEM STATES ---
typedef enum {
    SYS_INITIAL,
    SYS_CALIBRATING,
    SYS_TEST
} System_State_t;

typedef enum {
    DSP_IDLE,
    DSP_VALIDATING,
    DSP_COOLDOWN
} DSP_State_t;

System_State_t current_sys_state = SYS_INITIAL;
DSP_State_t current_dsp_state = DSP_IDLE;

// --- DMA & DSP BUFFERS ---
uint16_t adc_buffer[BUFFER_SIZE];
uint8_t data_ready_flag = 0;
uint8_t process_first_half = 0;

uint32_t sta = 0, lta = 0, state_timer = 0, ring_count = 0;
int8_t prev_polarity = 1;
// OLD: uint32_t dynamic_mid_rail = 2048;
float dynamic_mid_rail = 2048.0f;uint32_t energy_sum = 0;

// --- MACHINE LEARNING GLOBALS ---
uint32_t learned_profiles[4] = {0, 0, 0, 0};
uint8_t learn_stage = 0;
uint8_t drops_this_stage = 0;
uint32_t temp_energy_accumulator = 0;

// --- UART RX GLOBALS ---
uint8_t rx_byte;
char rx_buffer[50];
uint8_t rx_index = 0;
uint8_t msg_received = 0;
char tx_buf[150];
